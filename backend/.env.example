# Ada backend configuration. Copy to .env for local dev. In staging/prod, real secrets
# belong in Secret Manager, not a file. Unset optional keys just disable that feature.

# ── core ──────────────────────────────────────────────────────────────────────
APP_ENV=local                       # local | staging | prod
LOG_LEVEL=INFO
# Comma-separated CORS allowlist in staging/prod (wildcard is rejected there).
ALLOWED_ORIGIN=*
# Kill-switch: false ⇒ runs skip checkout and dispatch immediately (end-to-end testing).
# Set true before launch.
PAYMENTS_ENABLED=true

# ── database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ada
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

# ── AI (Gemini) ───────────────────────────────────────────────────────────────
# Either set GEMINI_API_KEY (AI Studio — runs the whole AI stack without GCP creds),
# or configure GCP_PROJECT/GCP_LOCATION for Vertex.
GEMINI_API_KEY=
GCP_PROJECT=your-project
GCP_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
LIVE_MODEL=gemini-live-2.5-flash-native-audio
LIVE_VOICE=Aoede
LLM_TIMEOUT_MS=60000
LLM_MAX_ATTEMPTS=3
# Uploaded CV originals + proctoring snapshots land here (empty = nothing stored).
GCS_BUCKET=

# ── job ingestion (Jooble feed keys, host -> key) ─────────────────────────────
JOOBLE_FEEDS={"jooble.org":"your-key","ng.jooble.org":"your-ng-key"}

# ── matching + interview ──────────────────────────────────────────────────────
JOBS_MATCH_K=5
INTERVIEW_QUESTIONS=5
STUCK_RUN_SECONDS=300

# ── one-click apply ───────────────────────────────────────────────────────────
APPLY_MAX_CONCURRENCY=3
APPLY_MAX_IN_FLIGHT_PER_USER=5
APPLY_STUCK_SECONDS=300

# ── proactive digest (scheduled) ──────────────────────────────────────────────
DIGEST_MATCHES=4
DIGEST_COOLDOWN_SECONDS=518400

# ── free CV assessment (public, rate-limited per IP) ──────────────────────────
ASSESS_RATE_LIMIT=5
ASSESS_RATE_WINDOW_SECONDS=3600

# ── verification credential (proctored assessment) ────────────────────────────
VERIFY_PASS_MARK=60
VERIFY_TIME_LIMIT_SECONDS=1800
VERIFY_MAX_ATTEMPTS=3
VERIFY_ATTEMPT_WINDOW_SECONDS=86400
VERIFY_RETAKE_COOLDOWN_SECONDS=1800
# Voice+camera sessions: face out of frame beyond this (seconds) flags for review.
VERIFY_FACE_ABSENT_LIMIT_SECONDS=25

# ── auth + email ──────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000       # base for links inside notifications
SESSION_COOKIE=ada_session
SESSION_TTL_DAYS=14                            # sliding window; refreshed on activity
RESEND_API_KEY=                                # unset locally logs the link instead
EMAIL_FROM=Ada <auth@yourdomain.com>

# ── admin dashboard ───────────────────────────────────────────────────────────
# Comma-separated emails granted /admin. Never assignable from inside the app.
# Empty ⇒ no admins.
ADMIN_EMAILS=

# ── WhatsApp (Twilio; optional — unset = channel skipped) ─────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=                           # e.g. whatsapp:+14155238886
TWILIO_VALIDATE_SIGNATURE=true                  # reject unsigned inbound webhooks

# ── Web Push (VAPID; optional — unset = push disabled) ────────────────────────
# Generate once: python scripts/gen_vapid.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@yourdomain.com

# ── Smile Identity KYC (optional — unset = identity falls back to self-attest) ─
SMILE_PARTNER_ID=
SMILE_API_KEY=
SMILE_BASE_URL=                                 # https://api.smileidentity.com (prod)
SMILE_DEFAULT_COUNTRY=NG

# ── Paystack — NGN (secrets to Secret Manager in prod) ────────────────────────
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx
PRICE_KOBO=200000                               # NGN 2,000 per run
CURRENCY=NGN

# ── Stripe — global (secrets to Secret Manager in prod) ───────────────────────
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_USD_CENTS=1500
STRIPE_CURRENCY=usd

# ── subscription plan codes (created in the Paystack/Stripe dashboards) ───────
# Keyed "<tier>_<cadence>", e.g. {"pro_monthly":"PLN_x","premium_annual":"PLN_y"}
PAYSTACK_PLANS={}
STRIPE_PRICES={}
